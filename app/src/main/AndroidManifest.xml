<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- So Uninstall can open the system uninstall dialog. Normal permission. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Haptics through the system vibrator. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- So swipe down can open the notification shade. Normal permission. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Android 15+: lets Android show a private space to the default home app. Normal permission.
         Unused while Settings > Privacy > Private space is off, which is the default. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Lets Android 11+ show us every app with a launcher icon, and every app that provides a
         widget (some have no launcher icon at all), without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:theme="@style/Plain">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Home"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <activity
            android:name=".PrivacyActivity"
            android:exported="false"
            android:label="@string/p_title" />

        <activity
            android:name=".IconEditActivity"
            android:exported="false"
            android:label="@string/edit_icon" />

        <!-- "Add to home screen" from Chrome and other apps: asks first, then adds. Exported because
             the system delivers the request; the request itself is checked through LauncherApps. -->
        <activity
            android:name=".PinShortcutActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Notification dots. Shipped disabled: Android can't connect to it, even with Notification
             access granted, until Settings > Privacy > Notification dots enables it. Exported so the
             system can bind it; BIND_NOTIFICATION_LISTENER_SERVICE means only the system can. -->
        <service
            android:name=".DotListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/p_dots"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
