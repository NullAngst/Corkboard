    <string name="p_title">Privacy</string>
    <string name="p_intro">Corkboard has no internet permission, so nothing can leave your phone through it. It keeps no logs and no analytics. Anything that needs extra access is off until you turn it on here.</string>
    <string name="p_off_until">Off until you turn them on</string>
    <string name="p_dots">Notification dots</string>
    <string name="p_dots_sub">Off by default: Android only shares notification counts with apps that can read every notification in full. With this on, Corkboard looks only at which app a notification is from, keeps that in memory, and never stores it. Needs Notification access.</string>
    <string name="p_access">Notification access</string>
    <string name="p_access_on">Allowed. Tap to change it in Android settings.</string>
    <string name="p_access_off">Not allowed. Tap to allow it in Android settings.</string>
    <string name="p_access_title">Allow Notification access</string>
    <string name="p_access_msg">Android will ask you to allow Notification access for Corkboard, and will warn that it can read all notifications. Corkboard only reads which app each one is from, to show the dot.</string>
    <string name="p_open_settings">Open settings</string>
    <string name="p_dot_color">Dot color</string>
    <string name="p_dot_icon">From the app icon</string>
    <string name="p_dot_accent">Theme accent</string>
    <string name="p_private">Private space</string>
    <string name="p_private_sub">Off by default, so private apps never show unless you choose. With this on, they appear in their own Private tab in the drawer and nowhere else: never on the home screen, in backups or in the icon cache.</string>
    <string name="p_private_unsupported">Needs Android 15 or newer</string>
    <string name="p_private_none">No private space found. Set one up in Android settings under Security and privacy, and keep Corkboard as the default home app.</string>
    <string name="p_permissions">What Corkboard asks Android for</string>
    <string name="p_permissions_sub">Every permission in this installed copy of Corkboard, read from the app itself.</string>
    <string name="p_no_internet">Corkboard doesn\'t ask for internet access, so it can\'t send anything anywhere. Backups go only to the file or folder you pick.</string>
    <string name="p_read_more">Privacy notes</string>
    <string name="perm_delete">Ask to uninstall apps</string>
    <string name="perm_delete_sub">Opens Android\'s own uninstall prompt. Android asks you to confirm; Corkboard can\'t remove anything by itself.</string>
    <string name="perm_vibrate">Vibrate</string>
    <string name="perm_vibrate_sub">Haptic feedback, which you can turn off under Haptics.</string>
    <string name="perm_shade">Open the notification shade</string>
    <string name="perm_shade_sub">For swipe down on the home screen.</string>
    <string name="perm_hidden">See a private space</string>
    <string name="perm_hidden_sub">Lets Android show your private space to the default home app. Unused while Private space above is off.</string>
    <string name="perm_unknown">%1$s. Not described in Corkboard yet.</string>
    <string name="p_most_used">Most used apps</string>
    <string name="p_most_used_sub">Off by default, since it means keeping a record of what you open. With this on, the drawer\'s first row shows the apps you open most, and they come first in search. Corkboard counts only the apps you open through it, keeps a fading count per app, and the day it last changed, on this phone only, never in backups, and deletes it all when you turn this off.</string>
    <string name="p_most_used_reset">Reset most used</string>
    <string name="p_most_used_reset_sub">Forget every count and start again</string>
    <string name="p_most_used_reset_msg">The most used row starts empty and fills again as you open apps.</string>
